# Optional overrides. Export them before manual commands, or use .env.services
# for the systemd services. The application does not automatically load .env.
CYBER_RSS_DATA_DIR=/absolute/path/to/persistent/runtime
# CYBER_RSS_BACKUP_DIR=/absolute/path/to/backup-volume
# CYBER_RSS_FEED_DIR=/absolute/path/to/feed-config
# CYBER_RSS_CATALOG_DIR=/absolute/path/to/catalogs
# HTTPS on the LAN: generate files with deploy/configure_https.py.
# CYBER_RSS_AUTH_FILE=/absolute/path/to/credentials.json
# CYBER_RSS_TLS_CERT_FILE=/absolute/path/to/server.crt
# CYBER_RSS_TLS_KEY_FILE=/absolute/path/to/server.key
# CYBER_RSS_RATE_PER_MINUTE=120
# CYBER_RSS_RATE_BURST=30
# CYBER_RSS_RATE_GLOBAL_PER_MINUTE=600
# CYBER_RSS_RATE_GLOBAL_BURST=60
