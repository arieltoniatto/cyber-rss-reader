[Unit]
Description=Cyber RSS periodic feed collector
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=exec
WorkingDirectory=@PROJECT@
EnvironmentFile=@ENVIRONMENT@
ExecStart=@PYTHON@ -m app.worker --interval @INTERVAL@
Restart=always
RestartSec=10
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
